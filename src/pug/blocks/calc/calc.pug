include ../../components/_ui/controls/main-radio/main-radio
include ../../components/_ui/controls/main-radio-sm/main-radio-sm
include ../../components/_ui/controls/main-radio-xs/main-radio-xs
include ../../components/_ui/controls/main-radio-dbl/main-radio-dbl

include ../../../content/step1 
include ../../../content/step2
include ../../../content/step3
include ../../../content/step4
include ../../../content/step5

section
  .container
    .lw-calc
      <div class="lw-steps-wrapper">
        <div class="swiper lw-steps">
          <div class="swiper-wrapper">
            <div class="swiper-slide">
              .lw-calc__step(data-id="1").viewed
                .lw-calc__step-underlay(aria-hidden=".lw-calc__total-table-rowue")
                .lw-calc__step-num 
                  span 1
                  small Шаг
                .lw-calc__step-value 
                  span Модель <br>двери
                  small Solo 1
            </div>
            <div class="swiper-slide">
              .lw-calc__step(data-id="2")
                .lw-calc__step-underlay(aria-hidden=".lw-calc__total-table-rowue")
                .lw-calc__step-num 
                  span 2 
                  small Шаг 
                .lw-calc__step-value 
                  span Покрытие <br>двери
                  small Lorem ipsum dolor sit amet consectetur, adipisicing elit. Omnis dolorem similique et. Repellat nam nemo libero! Numquam provident fugit aliquid commodi adipisci fugiat quam laudantium
            </div>
            <div class="swiper-slide">
              .lw-calc__step(data-id="3")
                .lw-calc__step-underlay(aria-hidden=".lw-calc__total-table-rowue")
                .lw-calc__step-num
                  span 3 
                  small Шаг
                .lw-calc__step-value 
                  span Наружняя сторона
                  small Lorem ipsum dolor sit amet
            </div>
            <div class="swiper-slide">
              .lw-calc__step(data-id="4")
                .lw-calc__step-underlay(aria-hidden=".lw-calc__total-table-rowue")
                .lw-calc__step-num 
                  span 4 
                  small Шаг
                .lw-calc__step-value 
                  span Внутренняя сторона
                  small Solo 1
            </div>
            <div class="swiper-slide">
              .lw-calc__step(data-id="5")
                .lw-calc__step-underlay(aria-hidden=".lw-calc__total-table-rowue")
                .lw-calc__step-num 
                  span 5 
                  small Шаг
                .lw-calc__step-value 
                  span Дополнительно
                  small Solo 1
            </div>
            <div class="swiper-slide">
              .lw-calc__step(data-id="6")
                .lw-calc__step-underlay(aria-hidden=".lw-calc__total-table-rowue")
                .lw-calc__step-num 
                  span 6
                  small Шаг
                .lw-calc__step-value 
                  span Итого
            </div>          
          </div>
        </div>
      </div>

      .lw-steps-content-wrapper
        .lw-steps-content(data-content="1")
          .lw-calc__field-container
            .lw-calc__field-wrapper
              fieldset.lw-calc__field(data-grid="1")
                each item in step1_content
                  +main-radio(item)
            .lw-calc__btn-row
              <button type="button" class="lw-calc__btn lw-calc__btn--next">Далее</button>
        .lw-steps-content(data-content="2")
          .lw-calc__field-container
            .lw-calc__field-wrapper
              fieldset.lw-calc__field(data-grid="2")
                each item in step2_content
                  +main-radio(item)

              .lw-calc__btn-row
                <button type="button" class="lw-calc__btn lw-calc__btn--outlined lw-calc__btn--prev">Назад</button>
                <button type="button" class="lw-calc__btn lw-calc__btn--next">Далее</button>
        .lw-steps-content(data-content="3")
          .lw-calc__field-container
            .lw-calc__field-wrapper
              fieldset.lw-calc__field(data-grid="3")
                each item in step3_content
                  +main-radio(item)
                
            .lw-calc-bottom-section
              .lw-calc__field-wrapper
                span.lw-calc__field-title ПВХ покрытие наружное
                fieldset.lw-calc__field(data-grid="4")
                  each item in step3_bottom_section_left_content
                    +main-radio-sm(item)
              
              .lw-calc__field-wrapper
                span.lw-calc__field-title Фурнитура
                fieldset.lw-calc__field(data-grid="5")
                  .lw-calc__field-section
                    each item in step3_bottom_section_middle_content
                      +main-radio-xs(item)
                  .lw-calc__field-section
                    .lw-complete-view(data-view="1") 
                      img(class="lw-complete-view__cover" src="./assets/img/step3_1-3.png" alt="Наружная сторона" width="260" height="480")
                      img(class="lw-complete-view__texture" src="./assets/img/textures/classic/1.png" alt="Наружная сторона" width="260" height="480")
                      img(class="lw-complete-view__hardware" src="./assets/img/gold-hardware.png" alt="Наружная сторона" width="260" height="480")

                  .lw-calc__btn-row
                    <button type="button" class="lw-calc__btn lw-calc__btn--outlined lw-calc__btn--prev">Назад</button>
                    <button type="button" class="lw-calc__btn lw-calc__btn--next">Далее</button>
              
              .lw-calc__field-wrapper
                span.lw-calc__field-title Оформление наружнее
                fieldset.lw-calc__field(data-grid="6")
                  each item in step3_bottom_section_right_content
                    +main-radio-sm(item)               
        .lw-steps-content(data-content="4")
          .lw-calc__field-container
            .lw-calc__field-wrapper
              fieldset.lw-calc__field(data-grid="3")
                each item in step4_content
                  +main-radio(item)
                
            .lw-calc-bottom-section
              .lw-calc__field-wrapper
                span.lw-calc__field-title ПВХ покрытие внутреннее
                fieldset.lw-calc__field(data-grid="4")
                  each item in step4_bottom_section_left_content
                    +main-radio-sm(item)
              
              .lw-calc__field-wrapper
                span.lw-calc__field-title Фурнитура
                fieldset.lw-calc__field(data-grid="5")
                  .lw-calc__field-section
                    each item in step4_bottom_section_middle_content
                      +main-radio-xs(item)
                  .lw-calc__field-section
                    .lw-complete-view 
                      img(class="lw-complete-view__cover" src="./assets/img/step3_1-3.png" alt="Наружная сторона" width="260" height="480")
                      img(class="lw-complete-view__texture" src="./assets/img/textures/classic/1.png" alt="Наружная сторона" width="260" height="480")
                      img(class="lw-complete-view__hardware" src="./assets/img/gold-hardware.png" alt="Наружная сторона" width="260" height="480")

                  .lw-calc__btn-row
                    <button type="button" class="lw-calc__btn lw-calc__btn--outlined lw-calc__btn--prev">Назад</button>
                    <button type="button" class="lw-calc__btn lw-calc__btn--next">Далее</button>
              
              .lw-calc__field-wrapper
                span.lw-calc__field-title Оформление внутреннее
                fieldset.lw-calc__field(data-grid="6")
                  each item in step4_bottom_section_right_content
                    +main-radio-sm(item)
        
        .lw-steps-content(data-content="5")
          .lw-calc__field-wrapper
            .lw-calc__field(data-grid="7")
              each item in step5_content
                +main-radio-dbl(item)
          .lw-calc__btn-row
            <button type="button" class="lw-calc__btn lw-calc__btn--outlined lw-calc__btn--prev">Назад</button>
            <button type="button" class="lw-calc__btn lw-calc__btn--next">Далее</button>          
        
        .lw-steps-content(data-content="6")
          .lw-calc__total
            .lw-calc__total-complete-view
              .lw-calc__total-complete-view-section
                .lw-complete-view.lw-complete-view--outer
                  img(class="lw-complete-view__cover" src="./assets/img/step3_1-3.png" alt="Наружная сторона" width="260" height="480")
                  img(class="lw-complete-view__texture" src="./assets/img/textures/classic/1.png" alt="Наружная сторона" width="260" height="480")
                  img(class="lw-complete-view__hardware" src="./assets/img/gold-hardware.png" alt="Наружная сторона" width="260" height="480")
                span Наружная сторона

              .lw-calc__total-complete-view-section
                .lw-complete-view.lw-complete-view--inner
                  img(class="lw-complete-view__cover" src="./assets/img/step3_1-3.png" alt="Наружная сторона" width="260" height="480")
                  img(class="lw-complete-view__texture" src="./assets/img/textures/classic/1.png" alt="Наружная сторона" width="260" height="480")
                  img(class="lw-complete-view__hardware" src="./assets/img/gold-hardware.png" alt="Наружная сторона" width="260" height="480")
                span Внутренняя сторона
          form(action="#")      
            .lw-calc__total-table
              .lw-calc__total-table-row(data-field="mod")
                .lw-calc__total-table-data Модель двери
                .lw-calc__total-table-data solo-1
                .lw-calc__total-table-data 23 800 ₽
              .lw-calc__total-table-row(data-step-result="zam")
                .lw-calc__total-table-data Замок
                .lw-calc__total-table-data Mettem 160,  Mettem 713
                .lw-calc__total-table-data 0 ₽
              .lw-calc__total-table-row(data-step-result="pok")
                .lw-calc__total-table-data Покрытия двери
                .lw-calc__total-table-data Белая Шагрель
                .lw-calc__total-table-data 2 000 ₽
              .lw-calc__total-table-row(data-step-result="narpvh")
                .lw-calc__total-table-data Наружная сторона ПВХ
                .lw-calc__total-table-data Сандал серый
                .lw-calc__total-table-data 0 ₽
              .lw-calc__total-table-row(data-step-result="narof")
                .lw-calc__total-table-data Наружное оформление
                .lw-calc__total-table-data 1
                .lw-calc__total-table-data 0 ₽
              .lw-calc__total-table-row(data-step-result="narfur")
                .lw-calc__total-table-data Наружная фурнитура
                .lw-calc__total-table-data Золото
                .lw-calc__total-table-data 1 500 ₽
              .lw-calc__total-table-row(data-step-result="vnpvh")
                .lw-calc__total-table-data Внутреняя сторона ПВХ
                .lw-calc__total-table-data Шиво светлый
                .lw-calc__total-table-data 0 ₽
              .lw-calc__total-table-row(data-step-result="vhof")
                .lw-calc__total-table-data Внутренее оформление
                .lw-calc__total-table-data 1
                .lw-calc__total-table-data 0 ₽
              .lw-calc__total-table-row(data-step-result="vnfur")
                .lw-calc__total-table-data Внутреняя фурнитура
                .lw-calc__total-table-data Золото
                .lw-calc__total-table-data 1 500 ₽
              .lw-calc__total-table-row(data-step-result="gl")
                .lw-calc__total-table-data Глазок
                .lw-calc__total-table-data Да
                .lw-calc__total-table-data 1 000 ₽
              .lw-calc__total-table-row(data-step-result="nal")
                .lw-calc__total-table-data Наличник
                .lw-calc__total-table-data Нет
                .lw-calc__total-table-data 0 ₽
              .lw-calc__total-table-row(data-step-result="port")
                .lw-calc__total-table-data Портал
                .lw-calc__total-table-data Да
                .lw-calc__total-table-data 8 500 ₽
              .lw-calc__total-table-row(data-step-result="porog")
                .lw-calc__total-table-data Порог
                .lw-calc__total-table-data Да
                .lw-calc__total-table-data 3 000 ₽
              .lw-calc__total-table-row(data-step-result="total")
                .lw-calc__total-table-data Итого
                .lw-calc__total-table-data 41 300 ₽


          .lw-calc__btn-row
            <button type="button" class="lw-calc__btn lw-calc__btn--outlined lw-calc__btn--prev">Назад</button>
            <button type="submit" class="lw-calc__btn lw-calc__btn--next">Отправить заявку</button>          
